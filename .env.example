# Neon Postgres (required)
# In the Neon Console, choose your project -> Connect and copy the pooled connection string.
# Keep the SSL option (sslmode=require) in the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/NEON_DATABASE?sslmode=require

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin authentication
# Generate a strong random string of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional local environment
NODE_ENV=development
